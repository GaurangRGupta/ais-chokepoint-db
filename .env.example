# Copy to .env and fill in. Never commit .env.

# AISStream: https://aisstream.io/  (GitHub login, Account, create key)
AISSTREAM_API_KEY=

# Open Waters fallback: https://openwaters.io/ais/token/
OPENWATERS_API_KEY=

# Set after Azure Session B. SSL required.
# DATABASE_URL=postgresql://chokepointadmin:PASSWORD@aiscpdbXXXX.postgres.database.azure.com:5432/chokepoint?sslmode=require
DATABASE_URL=

AZURE_STORAGE_ACCOUNT=
AZURE_BLOB_CONTAINER=ais-raw
