# Copy to .env and fill in. Never commit .env.

AISSTREAM_API_KEY=
OPENWATERS_API_KEY=

# PostgreSQL Flexible Server. SSL required.
# URL-encode the password if it contains @ # / % : ? &
# DATABASE_URL=postgresql://chokepointadmin:ENCODED_PASSWORD@aiscpdbgg013.postgres.database.azure.com:5432/chokepoint?sslmode=require
DATABASE_URL=

# Blob landing zone. Connection string is enough. Account plus key is the other option.
# Portal: storage account > Security + networking > Access keys.
AZURE_STORAGE_ACCOUNT=
AZURE_BLOB_CONTAINER=ais-raw
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_KEY=
